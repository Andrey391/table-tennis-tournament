{
  "name": "table-tennis-tournament",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "vercel-build": "npm run build -w client",
    "db:push": "npx prisma db push --schema=./server/prisma/schema.prisma",
    "db:seed": "npx tsx server/prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
