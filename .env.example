# .env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tttournament
JWT_SECRET=your-super-secret-key-change-me
JWT_EXPIRY=86400
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
SETUP_KEY=
# Outgoing mail for "forgot password" codes (any SMTP mailbox; Gmail/Yandex need an app password).
# Without SMTP_HOST a development server prints the letter to the console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
