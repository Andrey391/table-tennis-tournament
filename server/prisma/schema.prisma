generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  JUDGE
  PLAYER
  VIEWER
}

enum PlayerStatus {
  PENDING
  REGISTERED
  WITHDRAWN
  DISQUALIFIED
}

enum MatchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  firstName        String
  lastName         String
  role             Role      @default(PLAYER)
  city             String?
  // FNTR rating: fractional, because a win is worth (100 - gap) / 10 * KT points.
  rating           Float     @default(100)
  dateOfBirth      DateTime?
  phone            String?
  // A throwaway account handed to someone trying the app out, together with the
  // sparring partners its demo event is played against. Demo accounts are hidden
  // from the rating list and the leaderboards so a test run never touches the real
  // ladder, and the whole set is deleted once `demoExpiresAt` passes. Claiming the
  // account (signing up properly) clears `demoExpiresAt`, which is what makes the
  // evening the visitor just ran survive; `isDemo` stays true on the opponents so
  // they never turn into ladder entries.
  isDemo           Boolean   @default(false)
  // The guest account these demo opponents belong to, so the sweep removes a set
  // together. Deliberately a plain column, not a relation: the sweep deletes in
  // its own order and a self-referencing foreign key would only get in the way.
  demoOwnerId      String?
  demoExpiresAt    DateTime?
  // Consent to the processing of personal data (152-FZ): when it was given and
  // which version of the privacy policy it was given to. Null on accounts created
  // before the consent step existed and on demo accounts, which hold no real data.
  consentAt        DateTime?
  consentVersion   String?
  // Separate consent to showing the name to anyone at all (152-FZ art. 10.1):
  // false keeps the player off the rating list and the leaderboards and masks
  // their name in every response to a visitor who is not signed in.
  publicProfile    Boolean   @default(true)
  // Set when the owner deleted the account. The row survives, anonymised, because
  // the matches it played are part of other people's standings and ratings.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tournaments      TournamentUser[]
  matchesAsPlayer1 Match[]   @relation("player1")
  matchesAsPlayer2 Match[]   @relation("player2")
  judgedMatches    Match[]   @relation("judgeMatches")
  organizedTournaments Tournament[] @relation("tournamentOrganizer")
  auditLogs        AuditLog[]
  bookings         Booking[]
  subscriptions    Subscription[]
  chatMessages     ChatMessage[]
  createdClubs     Club[]    @relation("clubCreator")
  byes             RoundBye[]
  notifications    Notification[]

  @@index([city])
  @@index([rating])
  @@index([demoExpiresAt])
}

// A venue with tables. Clubs are what bookings, subscriptions and tournaments point at —
// A player is not "in" a club: the only link between the two is following it (Subscription).
// The old free-text User.club column is still in the database but no longer mapped.
model Club {
  id            String   @id @default(uuid())
  name          String
  city          String
  address       String?
  phone         String?
  createdById   String?
  createdBy     User?    @relation("clubCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tables        ClubTable[]
  bookings      Booking[]
  subscriptions Subscription[]
  tournaments   Tournament[]

  @@unique([name, city])
  @@index([city])
}

model ClubTable {
  id       String    @id @default(uuid())
  clubId   String
  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  number   Int
  indoor   Boolean   @default(true)
  // Optional — a table with no price is booked for free, same as before this
  // field existed. Set by the club manager; a booking snapshots it into
  // Booking.priceTotal so a later price change doesn't reshape past bookings.
  pricePerHour Float?
  bookings Booking[]

  @@unique([clubId, number])
  @@index([clubId])
}

// A tournament and a casual "game" are the same container — roster, rounds,
// pairing, standings — and differ only in `kind`: a GAME never touches anyone's
// Elo. Keeping one model means one pairing engine and one standings computation rather
// than two that drift apart.
model Tournament {
  id          String    @id @default(uuid())
  kind        String    @default("TOURNAMENT")
  name        String
  description String?
  tablesCount Int       @default(4)
  maxPlayers  Int?
  // How many sets a match here is played to. It is the target the scoring screen
  // prompts at, not a cap: a match runs for as many sets as the pair play, and the
  // judge settles it. Matches inherit it and can override it before they start.
  setsToWin   Int       @default(3)
  status      String    @default("DRAFT")
  startTime   DateTime?
  endTime     DateTime?
  minRating   Int?
  maxRating   Int?
  // FNTR significance coefficient (KT), 0.1-1, default 0.5: it scales every rating
  // change made by this event's matches. Ignored for a GAME, which is unrated.
  ratingWeight Float    @default(0.5)
  // Whether the event shows up in the public feed. Every table booking creates an
  // event, and a solo practice slot has no business sitting in the city feed next
  // to a club tournament — so a booking can keep its event to itself. Its own
  // participants and its organiser always see it.
  isPublic    Boolean   @default(true)
  // "OPEN" (default) vs "CLOSED". Joining always creates a PENDING request that the
  // manager must approve either way (self-join never grants REGISTERED directly) —
  // this flag only controls whether the client invites strangers to request a seat
  // at all, or hides that door behind an explicit invite/link.
  access      String    @default("OPEN")
  // Set once a COMPLETED tournament is put away by its manager. A completed
  // tournament can never be deleted (that would silently erase rating changes
  // already applied to its players) — archiving is the only way to get it out of
  // the general feed while keeping every match, set and rating change intact.
  archivedAt  DateTime?
  clubId      String?
  club        Club?     @relation(fields: [clubId], references: [id])
  organizerId String
  organizer   User      @relation("tournamentOrganizer", fields: [organizerId], references: [id])
  players     TournamentUser[]
  matches     Match[]
  byes        RoundBye[]
  chatMessages ChatMessage[]
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([kind, status])
  @@index([startTime])
  @@index([clubId])
}

// A table reservation. No payment processing — this is just a record of who booked what/when.
model Booking {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  clubId        String
  club          Club       @relation(fields: [clubId], references: [id])
  tableId       String?
  table         ClubTable? @relation(fields: [tableId], references: [id])
  date          DateTime
  startTime     String
  durationHours Float      @default(1)
  // What the table was booked for — a tournament or a game, which are the same
  // model. Cancelling the booking leaves the event alone (people may already have
  // joined it), so this is nullable.
  tournamentId  String?
  tournament    Tournament? @relation(fields: [tournamentId], references: [id])
  createdAt     DateTime   @default(now())
  // Snapshot of tableId's pricePerHour x durationHours at booking time — null
  // when the table (or club) has no price set, which keeps every booking made
  // before pricing existed, and every free table, exactly as free as they were.
  priceTotal    Float?
  paymentStatus PaymentStatus @default(UNPAID)
  // Opaque id handed back by whichever payment provider confirmed this booking.
  paymentRef    String?

  @@index([userId])
  @@index([clubId, date])
  @@index([tableId, date])
}

// Following a club, shown under "My subscriptions" — a plain follow list, not a paid plan.
model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clubId])
  @@index([userId])
}

// A simple per-tournament message board (polled, not real-time — see PollingProvider).
model ChatMessage {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  text         String
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
}

// Who sat a round out. With an odd headcount the pairing endpoint picks exactly
// one player per round and gives them no match; that used to be computed in the
// client as "on the roster but in none of this round's matches", which silently
// lied about rounds that happened before a latecomer joined.
model RoundBye {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  round        Int
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, round])
  @@index([tournamentId])
}

model TournamentUser {
  id           String       @id @default(uuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  seed         Int?
  // The player's rating before their first rated match in this event. FNTR rates
  // every match of a tournament against the ratings the players brought to it, not
  // against ratings that earlier rounds have already moved. Written when their first
  // match is settled (nothing in this event can have moved their rating before that).
  ratingStart  Float?
  status       PlayerStatus @default(REGISTERED)
  joinedAt     DateTime     @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([tournamentId, seed])
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
  round        Int         @default(1)
  matchIndex   Int?
  tableNumber  Int?
  player1Id    String?
  player1      User?       @relation("player1", fields: [player1Id], references: [id])
  player2Id    String?
  player2      User?       @relation("player2", fields: [player2Id], references: [id])
  judgeId      String?
  judge        User?       @relation("judgeMatches", fields: [judgeId], references: [id])
  // Sets this match is played to — a target the scoring screen prompts at, not a
  // cap. Only COMPLETED matches reach the statistics, the standings and Elo, and
  // a match is completed by /end, /forfeit or a walkover.
  setsToWin    Int         @default(3)
  // The rating the winner gained (FNTR) and the loser gave up when this match was
  // settled, kept so that reopening it can hand both back exactly. The FNTR exchange
  // is not zero-sum, so the loser's change is its own column. Both are null for an
  // unrated match (a game or a walkover) and 0 when the winner was over 100 ahead.
  // The column names predate FNTR, when this was Elo.
  eloDelta     Float?
  eloDeltaLoser Float?
  // Both players' ratings at the moment the match was settled, so "best win" and
  // "beat someone 100+ above" compare against the rating they had then, not now.
  rating1Before Float?
  rating2Before Float?
  sets         MatchSet[]
  // Running tally of sets won. There is no fixed "best of N": sets are played
  // one after another and the judge ends the match, whoever leads takes it.
  setsWon1     Int         @default(0)
  setsWon2     Int         @default(0)
  status       MatchStatus @default(NOT_STARTED)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tournamentId])
  @@index([tournamentId, round])
  @@index([status])
}

// One set ("партия") inside a match. A set is the unit of scoring: the judge marks
// who took it and that is all that is recorded. The rally-by-rally score is not
// tracked, so `winner` is the whole content of a set and undo simply removes the
// last row.
//
// `score1`/`score2` hold the set's rally score ("11:7") when someone typed it in —
// optional, for the record only; 0:0 means it was not entered. Nothing derives the
// winner from it and there is still no point-by-point play.
//
// The database still carries the other old point-by-point columns (serverSide,
// lastScorer, prevServerSide, letCount, pointsToWin). They are left in
// place rather than dropped — dropping columns costs data — but nothing reads or
// writes them any more, so they are not mapped here. Every one of them has a
// default, which is why inserts that omit them still work.
model MatchSet {
  id        String      @id @default(uuid())
  matchId   String
  match     Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  index     Int
  status    MatchStatus @default(IN_PROGRESS)
  winner    Int?
  score1    Int         @default(0)
  score2    Int         @default(0)
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  @@unique([matchId, index])
  @@index([matchId])
}

// Something that happened to this user while they were not looking: a join
// request for their event, the next round paired, a match settled. Written by
// `notify()` (server/src/shared/notify.ts) as a side effect of the route that
// caused it. The text is not stored — only `type` and `params` — so the client
// renders it in the reader's language. `tournamentId` is a plain column rather
// than a relation: deleting an event must not have to clear anyone's inbox first.
model Notification {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  params       Json?
  // In-app path the notification opens, e.g. /tournament/<id>.
  link         String?
  tournamentId String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([tournamentId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
