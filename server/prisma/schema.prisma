generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  JUDGE
  PLAYER
  VIEWER
}

enum PlayerStatus {
  PENDING
  REGISTERED
  WITHDRAWN
  DISQUALIFIED
}

enum MatchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  firstName        String
  lastName         String
  role             Role      @default(PLAYER)
  club             String?
  city             String?
  rating           Int       @default(100)
  dateOfBirth      DateTime?
  phone            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tournaments      TournamentUser[]
  matchesAsPlayer1 Match[]   @relation("player1")
  matchesAsPlayer2 Match[]   @relation("player2")
  judgedMatches    Match[]   @relation("judgeMatches")
  organizedTournaments Tournament[] @relation("tournamentOrganizer")
  organizedGames   Game[]    @relation("gameOrganizer")
  gamesAsPlayer1   Game[]    @relation("gamePlayer1")
  gamesAsPlayer2   Game[]    @relation("gamePlayer2")
  auditLogs        AuditLog[]
  bookings         Booking[]
  subscriptions    Subscription[]
  chatMessages     ChatMessage[]
  createdClubs     Club[]    @relation("clubCreator")

  @@index([club])
  @@index([city])
  @@index([rating])
}

// A venue with tables. Clubs are what bookings, subscriptions and tournaments point at —
// the old free-text `club` string on User is now only a display-level "home club" note.
model Club {
  id            String   @id @default(uuid())
  name          String
  city          String
  address       String?
  phone         String?
  createdById   String?
  createdBy     User?    @relation("clubCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tables        ClubTable[]
  bookings      Booking[]
  subscriptions Subscription[]
  tournaments   Tournament[]
  games         Game[]

  @@unique([name, city])
  @@index([city])
}

model ClubTable {
  id       String    @id @default(uuid())
  clubId   String
  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  number   Int
  indoor   Boolean   @default(true)
  bookings Booking[]
  games    Game[]

  @@unique([clubId, number])
  @@index([clubId])
}

model Tournament {
  id          String    @id @default(uuid())
  name        String
  description String?
  tablesCount Int       @default(4)
  maxPlayers  Int?
  status      String    @default("DRAFT")
  startTime   DateTime?
  endTime     DateTime?
  minRating   Int?
  maxRating   Int?
  clubId      String?
  club        Club?     @relation(fields: [clubId], references: [id])
  organizerId String
  organizer   User      @relation("tournamentOrganizer", fields: [organizerId], references: [id])
  players     TournamentUser[]
  matches     Match[]
  chatMessages ChatMessage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([clubId])
}

// A table reservation. No payment processing — this is just a record of who booked what/when.
model Booking {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  clubId        String
  club          Club       @relation(fields: [clubId], references: [id])
  tableId       String?
  table         ClubTable? @relation(fields: [tableId], references: [id])
  date          DateTime
  startTime     String
  durationHours Float      @default(1)
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([clubId, date])
  @@index([tableId, date])
}

// Following a club, shown under "My subscriptions" — a plain follow list, not a paid plan.
model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clubId])
  @@index([userId])
}

// A simple per-tournament message board (polled, not real-time — see PollingProvider).
model ChatMessage {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  text         String
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
}

// A casual game: two players, one game to the target score, scored exactly like a
// tournament match but deliberately UNRATED — Elo never moves for these, which is
// the whole point of having them separate from Match.
model Game {
  id             String      @id @default(uuid())
  title          String?
  clubId         String?
  club           Club?       @relation(fields: [clubId], references: [id])
  tableId        String?
  table          ClubTable?  @relation(fields: [tableId], references: [id])
  startTime      DateTime?
  pointsToWin    Int         @default(11)
  organizerId    String
  organizer      User        @relation("gameOrganizer", fields: [organizerId], references: [id])
  player1Id      String?
  player1        User?       @relation("gamePlayer1", fields: [player1Id], references: [id])
  player2Id      String?
  player2        User?       @relation("gamePlayer2", fields: [player2Id], references: [id])
  score1         Int         @default(0)
  score2         Int         @default(0)
  serverSide     Int         @default(1)
  lastScorer     Int?
  prevServerSide Int?
  letCount       Int         @default(0)
  status         MatchStatus @default(NOT_STARTED)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([clubId])
}

model TournamentUser {
  id           String       @id @default(uuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  seed         Int?
  status       PlayerStatus @default(REGISTERED)
  joinedAt     DateTime     @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([tournamentId, seed])
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
  round        Int         @default(1)
  matchIndex   Int?
  tableNumber  Int?
  player1Id    String?
  player1      User?       @relation("player1", fields: [player1Id], references: [id])
  player2Id    String?
  player2      User?       @relation("player2", fields: [player2Id], references: [id])
  judgeId      String?
  judge        User?       @relation("judgeMatches", fields: [judgeId], references: [id])
  pointsToWin  Int         @default(11)
  score1       Int         @default(0)
  score2       Int         @default(0)
  serverSide   Int         @default(1)
  lastScorer   Int?
  prevServerSide Int?
  letCount     Int         @default(0)
  status       MatchStatus @default(NOT_STARTED)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tournamentId])
  @@index([tournamentId, round])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
