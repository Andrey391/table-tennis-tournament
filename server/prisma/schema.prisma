generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  JUDGE
  PLAYER
  VIEWER
}

enum PlayerStatus {
  REGISTERED
  WITHDRAWN
  DISQUALIFIED
}

enum MatchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  firstName        String
  lastName         String
  role             Role      @default(PLAYER)
  club             String?
  rating           Int       @default(1000)
  dateOfBirth      DateTime?
  phone            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tournaments      TournamentUser[]
  matchesAsPlayer1 Match[]   @relation("player1")
  matchesAsPlayer2 Match[]   @relation("player2")
  judgedMatches    Match[]   @relation("judgeMatches")
  organizedTournaments Tournament[] @relation("tournamentOrganizer")
  auditLogs        AuditLog[]

  @@index([club])
  @@index([rating])
}

model Tournament {
  id          String    @id @default(uuid())
  name        String
  tablesCount Int       @default(4)
  status      String    @default("DRAFT")
  startTime   DateTime?
  endTime     DateTime?
  organizerId String
  organizer   User      @relation("tournamentOrganizer", fields: [organizerId], references: [id])
  players     TournamentUser[]
  matches     Match[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([startTime])
}

model TournamentUser {
  id           String       @id @default(uuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  seed         Int?
  status       PlayerStatus @default(REGISTERED)
  joinedAt     DateTime     @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([tournamentId, seed])
}

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
  matchIndex   Int?
  tableNumber  Int?
  player1Id    String?
  player1      User?       @relation("player1", fields: [player1Id], references: [id])
  player2Id    String?
  player2      User?       @relation("player2", fields: [player2Id], references: [id])
  judgeId      String?
  judge        User?       @relation("judgeMatches", fields: [judgeId], references: [id])
  pointsToWin  Int         @default(11)
  score1       Int         @default(0)
  score2       Int         @default(0)
  serverSide   Int         @default(1)
  lastScorer   Int?
  prevServerSide Int?
  letCount     Int         @default(0)
  status       MatchStatus @default(NOT_STARTED)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tournamentId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
